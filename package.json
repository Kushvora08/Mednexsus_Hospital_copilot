{
  "name": "mednexsus",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start --go --lan --clear",
    "android": "expo start --go --lan --android",
    "ios": "expo start --go --lan --ios",
    "start:tunnel": "expo start --go --tunnel --clear",
    "build:android": "expo prebuild --platform android --no-clean && expo run:android",
    "build:ios": "expo prebuild --platform ios --no-clean && expo run:ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "test": "node --test tests/*.test.cjs"
  },
  "dependencies": {
    "@expo-google-fonts/cormorant-garamond": "^0.4.1",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.22",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "react-test-renderer": "^19.3.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
